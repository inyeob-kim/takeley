ENVIRONMENT=local
DEBUG=True
# LOG_LEVEL overrides ENVIRONMENT/DEBUG when set (DEBUG|INFO|WARNING|ERROR).
# Empty + local/DEBUG=true → DEBUG. production → INFO.
LOG_LEVEL=
DATABASE_URL=postgresql+psycopg://takeley:takeley@localhost:5432/takeley
# Local SQLite (dev fallback):
# DATABASE_URL=sqlite:///./takeley.db
# Production (AWS RDS): use terraform output -raw database_url — see deploy/README.md

# TAKELEY MVP
MVP_ASSET_SYMBOL=TSLA
MVP_ASSET_NAME=Tesla
MVP_ASSET_NAME_KO=테슬라
# Shared US monitor set — edit this list to manage wide-market coverage (no code change).
# Comma-separated tickers. Watchlist overlays this. Restart API/worker after edits.
# Empty = MVP seed + watchlist only.
MONITOR_SET_SYMBOLS=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,BRK.B,JPM,XOM,JNJ,V,UNH,HD,PG,AVGO,COST,SCHD,VYM,SPY,QQQ,DIA
# Cap distinct X symbol-search queries per heavy ingest cycle.
X_SEARCH_QUERY_BUDGET=8
# Industry trending Issue topics (X recent-search).
# Keys: politics,economy,finance,tech,ai,society,world,culture,sports,entertainment
# Each industry expands to korea+global discovery lanes; X_TOPIC_QUERY_BUDGET caps per cycle (default 8).
ISSUE_INDUSTRIES=politics,economy,finance,tech,ai,society,world,culture,sports,entertainment
ISSUE_X_TOPIC_ENABLED=true
X_TOPIC_QUERY_BUDGET=8
# Issue pipeline (legacy V1 process path removed).
# Discovery always omits has:replies. Heat only caps candidate pool size.
ISSUE_INGEST_FOCUS=true
ISSUE_LLM_UNDERSTAND_BUDGET_PER_CYCLE=12
ISSUE_LLM_MATCH_SHORTLIST=8
COLUMNIST_ISSUE_PAGE_SIZE=10
COLUMNIST_ISSUE_PAGE_MAX=40
DAILY_ISSUE_SOFT_CAP=0
ISSUE_EMBEDDING_ENABLED=true
ISSUE_EMBEDDING_MODEL=text-embedding-3-small
ISSUE_LLM_QUALITY_JUDGE_ENABLED=true
ISSUE_DYNAMIC_QUERY_ENABLED=true
ISSUE_DYNAMIC_QUERY_BUDGET=2
ISSUE_TOPIC_REQUIRE_PARTICIPATION=false
X_TOPIC_SEARCH_INTERVAL_SECONDS=1800
X_TOPIC_QUERY_BUDGET=8
# Heat ranks pool only (not Issue create hard gate).
ISSUE_MIN_ENGAGEMENT_SCORE=15
ISSUE_MIN_REPLY_COUNT=5
ISSUE_TOPIC_KEEP_PER_QUERY=8
INGEST_INTERVAL_SECONDS=1800
# Local retest only: true → heavy wake + X/RSS/topic/DART intervals = 60s. Keep false otherwise.
TEST_FAST_INGEST=false
TEST_INGEST_INTERVAL_SECONDS=60
# Brief/TTS poll (separate from heavy ingest). Aim: create within ~1 min of alarm.
BRIEF_POLL_INTERVAL_SECONDS=60
# Home feed: watchlist symbols get this many seconds of recency bump (default 90m).
HOME_WATCHLIST_BOOST_SECONDS=5400
DAILY_SIGNAL_CAP=10
# Soft pool: per-symbol minimum and bootstrap can still publish under HARD_CEILING.
PER_SYMBOL_DAILY_MIN=2
BOOTSTRAP_PER_SYMBOL_MAX=3
DAILY_SIGNAL_HARD_CEILING=30
# Optional HIGH escape via existing importance (set 1.01 to disable).
PRIORITY_IMPORTANCE_THRESHOLD=0.85
MIN_SIGNAL_IMPORTANCE=0.4
MIN_SIGNAL_CONFIDENCE=0.3
NEWS_RSS_URL=https://news.google.com/rss/search?q=US+stocks&hl=en-US&gl=US&ceid=US:en
# Comma-separated X accounts for timeline ingest (no @). Prefer US wires; restart worker after edits.
X_TRACK_ACCOUNTS=DeItaone,StockMKTNewz,FirstSquawk
# Optional macro keep terms (comma-separated). Empty = built-in Fed/oil/Trump/… defaults.
MACRO_THEME_KEYWORDS=
MACRO_INDEX_SYMBOLS=SPY,QQQ
# Per-source intervals (seconds). Worker wake interval is still INGEST_INTERVAL_SECONDS.
X_ACCOUNTS_INTERVAL_SECONDS=3600
X_SEARCH_INTERVAL_SECONDS=1800
RSS_INTERVAL_SECONDS=3600
# Fetch publisher HTML after RSS (needed so analyze does not invent prices from headlines).
NEWS_FETCH_BODY=true
NEWS_BODY_TIMEOUT_SECONDS=12
NEWS_BODY_MAX_CHARS=6000
NEWS_BODY_MIN_CHARS=280
NEWS_RSS_PARSE_MULTIPLIER=5
NEWS_BODY_SCAN_MULTIPLIER=4
# true only for local offline demos — never injects headline-only real RSS items.
NEWS_DEMO_FALLBACK=false
BRIEF_CANDIDATE_LIMIT=24
BRIEF_SLOT_COUNT=6
TTS_ENABLED=true
TTS_MODEL=tts-1
TTS_VOICE=nova
BRIEF_AUDIO_DIR=./storage/briefs
ISSUE_IMAGE_DIR=./storage/issue_images
ISSUE_IMAGE_MAX_BYTES=5000000

# OpenAI
OPENAI_API_KEY=
# Chat model for analyze / brief select / brief script (default gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# X / Twitter (fetch uses BEARER; write keys optional)
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
CLIENT_ID=
CLIENT_SECRET=

# Bing Image Search (optional / unused for now)
BING_IMAGE_SEARCH_KEY=
BING_IMAGE_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/images/search

# Admin portal (Vite) CORS — default admin port 5174
# Local admin (Vite). Production: https://admin.<domain> — see deploy/env/backend.env.example
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# CORS_ORIGINS=https://admin.example.com
# Unused by share landing (kept for compat). Leave empty.
PUBLIC_WEB_ORIGIN=
# Origin for /i/:id OG landing + og:url (usually the API host).
PUBLIC_SHARE_ORIGIN=http://127.0.0.1:8000
# Optional store URLs when share CTA cannot open the app (leave empty for web hint).
PUBLIC_ANDROID_STORE_URL=
PUBLIC_IOS_STORE_URL=

# Symbol catalog (assets/search). Finnhub preferred; Yahoo used when key empty.
FINNHUB_API_KEY=
# OpenDART (국내 공시). https://opendart.fss.or.kr 에서 인증키 발급.
# 비우면 KR 관심종목의 공시 ingest는 스킵됩니다.
DART_API_KEY=
DART_LOOKBACK_DAYS=14
DART_INTERVAL_SECONDS=3600
DART_CORP_CODE_CACHE_PATH=./storage/dart_corp_codes.json
# 국내주식 Google News (hl=ko). 서학 MVP 기본 OFF — 필요 시 true.
KR_NEWS_ENABLED=false
KR_NEWS_INTERVAL_SECONDS=3600
SYMBOL_YAHOO_ENABLED=true
SYMBOL_VENDOR_TIMEOUT_SECONDS=5
ASSET_SEARCH_LIMIT=20

# Macro calendar (worker sync; API reads DB)
CALENDAR_API_URL=https://xoomar.com/api/markets/calendar
CALENDAR_SYNC_INTERVAL_SECONDS=86400
CALENDAR_LOOKBACK_DAYS=7
CALENDAR_LOOKAHEAD_DAYS=60
CALENDAR_IMPORTANCE=high
CALENDAR_TIMEOUT_SECONDS=15
CALENDAR_SEED_FALLBACK=true

# IAP (Pro) — device-linked; store verify TBD
IAP_IOS_PRODUCT_ID=market_radar.pro.monthly
IAP_ANDROID_PRODUCT_ID=market_radar.pro.monthly

# Push / FCM (worker sends; leave disabled until credentials exist)
FCM_ENABLED=false
FIREBASE_CREDENTIALS_PATH=
SIGNAL_PUSH_DAILY_CAP=5
# Signal detail Ask AI (per-user). Same OPENAI_MODEL as pipeline.
EXPLAIN_DAILY_CAP=20
EXPLAIN_MAX_SELECTION_CHARS=280

# Cost observability (optional USD rates — leave empty = CONFIG_REQUIRED, no invented prices)
# COST_LLM_INPUT_USD_PER_1M=
# COST_LLM_OUTPUT_USD_PER_1M=
# COST_TTS_USD_PER_1M_CHARS=
# COST_X_USD_PER_REQUEST=
# COST_FINNHUB_USD_PER_REQUEST=
# COST_HTTP_USD_PER_REQUEST=

# Admin review portal — header X-Admin-Key. Empty disables /api/v1/admin/*
ADMIN_API_KEY=

