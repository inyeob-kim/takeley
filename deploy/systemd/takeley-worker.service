[Unit]
Description=TAKELEY worker (ingest + process)
After=network.target takeley-api.service

[Service]
Type=simple
User=takeley
Group=takeley
WorkingDirectory=/opt/takeley/backend
EnvironmentFile=/etc/takeley/backend.env
ExecStart=/opt/takeley/backend/.venv/bin/python -m worker.main
Restart=always
RestartSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
