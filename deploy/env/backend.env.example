# Production backend env — copy to /etc/takeley/backend.env on the server.
# Never commit real secrets.

ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

# From: terraform output -raw database_url
DATABASE_URL=postgresql+psycopg://takeley:CHANGE_ME@CHANGE_RDS_HOST:5432/takeley

# Comma-separated; must include Admin HTTPS origin
CORS_ORIGINS=https://admin.DOMAIN_NAME

PUBLIC_SHARE_ORIGIN=https://DOMAIN_NAME
PUBLIC_WEB_ORIGIN=

ADMIN_API_KEY=CHANGE_ME_LONG_RANDOM

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TWITTER_BEARER_TOKEN=

FCM_ENABLED=true
# Worker reads FIREBASE_CREDENTIALS_PATH (not GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_CREDENTIALS_PATH=/etc/takeley/firebase-credentials.json
GOOGLE_APPLICATION_CREDENTIALS=/etc/takeley/firebase-credentials.json

ISSUE_IMAGE_DIR=/opt/takeley/storage/issue_images
BRIEF_AUDIO_DIR=/opt/takeley/storage/briefs
