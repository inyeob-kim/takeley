# —— OS / IDE ——
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
*.log

# —— Secrets / local env ——
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.p8
*.p12
*.jks
*.keystore
credentials.json
*-credentials.json
**/firebase-credentials*.json
**/google-services.json
**/GoogleService-Info*.plist

# —— Python / backend ——
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
backend/.venv/
.pytest_cache/
backend/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
backend/storage/

# —— Admin (Vite) ——
admin/node_modules/
admin/dist/
admin/.vite/

# —— AWS / Terraform deploy ——
# Keep: .tf, examples, scripts, nginx/systemd, .terraform.lock.hcl
deploy/bin/
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/.terraform.tfstate.lock.info
deploy/terraform/*.tfplan
deploy/terraform/tfplan
deploy/terraform/*.tfvars
deploy/terraform/*.auto.tfvars
deploy/terraform/override.tf
deploy/terraform/override.tf.json
deploy/terraform/*_override.tf
deploy/terraform/*_override.tf.json
!deploy/terraform/*.example
deploy/env/*
!deploy/env/*.example

